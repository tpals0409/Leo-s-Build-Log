# podman compose가 읽음. 로컬 `npm run dev`는 .env.local에 DATABASE_URL도 넣을 것
ADMIN_TOKEN=change-me-long-random
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://blog:change-me@localhost:5432/blog
APP_PORT=3000
# 검색엔진용 canonical/hreflang 주소의 기준. 도메인 생기면 바꿀 것
SITE_URL=http://localhost:3000
# /admin Google 로그인: Google Cloud OAuth 클라이언트(웹), 리디렉션 URI = $SITE_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=you@gmail.com
# 챗봇(레오에 대해 물어보기, lib/chat.ts). 없으면 챗봇만 '준비 중'. DB에 pgvector 확장이 있어야 함
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-6-luna
# 챗봇의 레오 사실 그래프(content/profile → Neo4j). 없으면 블로그 글만으로 답함. compose의 neo4j 서비스 비밀번호(8자 이상)
NEO4J_PASSWORD=
# 로컬 npm run dev는 .env.local에 NEO4J_URL=http://localhost:7474, NEO4J_USER=neo4j, NEO4J_PASSWORD도
# 방문 통계(자체 호스팅 Umami, components/Analytics.tsx). 둘 다 있을 때만 스크립트를 넣는다
# UMAMI_SCRIPT_URL=https://<umami 주소>/script.js
# UMAMI_WEBSITE_ID=
